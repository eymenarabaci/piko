{
  "id": "office",
  "version": "0.1.0",
  "description": "Yerel dosya okuma, rapor taslağı ve onaylı çıktı yazma: sıfır dış risk.",
  "levels": [
    "read",
    "draft",
    "apply"
  ],
  "idempotency": {
    "type": "keyed",
    "key": "idempotency_key"
  },
  "evidence": {
    "format": "office-evidence",
    "fields": [
      "files",
      "sha256",
      "summary"
    ]
  },
  "errors": {
    "retryable": [
      "timeout",
      "rate-limited",
      "partial-write"
    ],
    "needs-user": [
      "missing-input",
      "ambiguous-request",
      "approval-required",
      "unsafe-target"
    ],
    "external-down": [
      "connection-refused",
      "service-unavailable",
      "filesystem-unavailable"
    ]
  },
  "approval": {
    "apply": "per_call_token"
  },
  "adapter": "manager.packs.office:adapter"
}
