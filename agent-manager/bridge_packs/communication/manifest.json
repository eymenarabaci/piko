{
  "id": "communication",
  "version": "0.1.0",
  "description": "Gelen kutusu ve takvim okuma, taslak mail/toplantı üretimi, onaylı gönderim. Çevrimdışı fixture sunucusu; canlı sağlayıcıya geçiş yalnız adaptör değişimidir.",
  "levels": [
    "read",
    "draft",
    "apply"
  ],
  "idempotency": {
    "type": "keyed",
    "key": "idempotency_key"
  },
  "evidence": {
    "format": "communication-evidence",
    "fields": [
      "message_id",
      "recipients",
      "preview_sha256",
      "kind"
    ]
  },
  "errors": {
    "retryable": [
      "timeout",
      "rate-limited",
      "network-error",
      "mailbox-locked"
    ],
    "needs-user": [
      "missing-input",
      "ambiguous-request",
      "approval-required",
      "no-recipients",
      "unsafe-recipient"
    ],
    "external-down": [
      "provider-unavailable",
      "smtp-refused",
      "calendar-unavailable"
    ]
  },
  "approval": {
    "apply": "per_call_token"
  },
  "adapter": "manager.packs.communication:adapter"
}
