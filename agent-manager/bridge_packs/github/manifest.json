{
  "id": "github",
  "version": "0.1.0",
  "description": "Git geçmişi, diff ve issue/PR okuma; lokal branch/commit/PR taslağı; onaylı push ve PR açma.",
  "levels": [
    "read",
    "draft",
    "apply"
  ],
  "idempotency": {
    "type": "keyed",
    "key": "idempotency_key"
  },
  "evidence": {
    "format": "github-evidence",
    "fields": [
      "branch",
      "commit_sha",
      "pr_url",
      "test_summary",
      "source"
    ]
  },
  "errors": {
    "retryable": [
      "timeout",
      "rate-limited",
      "network-error",
      "push-rejected-transient"
    ],
    "needs-user": [
      "missing-input",
      "ambiguous-request",
      "approval-required",
      "no-changes",
      "dirty-worktree",
      "unsafe-target"
    ],
    "external-down": [
      "gh-unavailable",
      "remote-unavailable",
      "auth-required"
    ]
  },
  "approval": {
    "apply": "per_call_token"
  },
  "adapter": "manager.packs.github:adapter"
}
